---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import TagPills from '../../components/TagPills.astro';
import BigProofCard from '../../components/BigProofCard.astro';
import RelatedMachines from '../../components/RelatedMachines.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export async function getStaticPaths() {
  const entries = await getCollection('machines', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const isRetired = data.status === 'retired';
const { Content } = await entry.render();

// Rough reading-time estimate from the raw markdown body
const bodyText = (entry.body ?? '').toString();
const words = bodyText.trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 220));

const pageTitle = isRetired
  ? `${data.title} — HTB Writeup`
  : `${data.title} — HTB Machine (solved)`;

// Active machines: HTB rules forbid sharing how an active machine was solved,
// so nothing about the attack path (summary, techniques, CVEs, body) is rendered.
const LOCKED_SUMMARY = 'Solved (user and root). Writeup will be published once HTB retires this machine.';
const publicSummary = isRetired ? data.summary : LOCKED_SUMMARY;
const publicTechniques = isRetired ? data.techniques : [];
const publicCves = isRetired ? data.cves : [];
---
<BaseLayout title={pageTitle} description={publicSummary}>
  <ReadingProgress />
  <article class="writeup">
    <div class="container">
      <a href="/" class="back-link">&larr; all machines</a>

      <header class="machine-hero">
        <div class="machine-hero-main">
          <div class="crumbs mono">
            <span>machines</span>
            <span class="sep">/</span>
            <span class="accent">{entry.slug}</span>
            {isRetired
              ? <span class="chip retired">RETIRED</span>
              : <span class="chip locked">&#128274; ACTIVE</span>}
          </div>
          <h1>{data.title}</h1>
          <p class="hero-sum">{publicSummary}</p>
          <div class="hero-meta mono">
            {data.os && <span>{data.os}</span>}
            {data.difficulty && <span class={`meta-diff ${data.difficulty.toLowerCase()}`}>&middot; {data.difficulty}</span>}
            {isRetired && <span>&middot; ~{readingTime} min read</span>}
            {data.date && <span>&middot; {data.date.toLocaleDateString('en-GB', { year:'numeric', month:'short', day:'numeric' })}</span>}
          </div>
        </div>
      </header>

      <InfoBox
        os={data.os}
        difficulty={data.difficulty}
        points={data.points}
        status={data.status}
        date={data.date}
        ownedUser={data.ownedUser}
        ownedRoot={data.ownedRoot}
        techniques={publicTechniques}
        cves={publicCves}
      />

      {publicTechniques.length > 0 && <TagPills items={publicTechniques} title="Skills exercised" />}
      {publicCves.length > 0 && <TagPills items={publicCves} title="CVEs referenced" />}

      {isRetired ? (
        <>
          {data.proof && (
            <figure class="proof-fig">
              <img src={data.proof} alt={`Proof of pwn for ${data.title}`} loading="lazy" />
              <figcaption>Proof of completion &middot; {data.title}</figcaption>
            </figure>
          )}
          <div class="prose">
            <Content />
          </div>
        </>
      ) : (
        <>
          <div class="summary-banner mono">
            <span class="tag">MACHINE SUMMARY</span>
            <span>Owned user &amp; root &middot; writeup locked until retirement (HTB policy)</span>
          </div>
          {data.proof && (
            <BigProofCard
              machine={data.title}
              proof={data.proof}
              status={data.status}
              pwnDate={data.date}
            />
          )}
        </>
      )}

      <RelatedMachines
        currentSlug={entry.slug}
        techniques={publicTechniques}
        os={data.os}
        difficulty={data.difficulty}
      />
    </div>
  </article>
</BaseLayout>
